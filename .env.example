# Copy to .env and edit. Every value below is also the built-in default, so the
# pipeline runs correctly with no .env at all — this file exists to make the
# tunables discoverable and overridable, not to make them mandatory.
#
#   cp .env.example .env
#
# .env is gitignored; .env.example is committed so a fresh clone knows what exists.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR. INFO prints one line per stage; DEBUG adds the
# per-gig detail that makes a bad ranking traceable.
PIPELINE_LOG_LEVEL=INFO

# Python logging format string. Keep %(name)s when debugging (it names the module).
PIPELINE_LOG_FORMAT=%(asctime)s %(levelname)-8s %(name)-28s %(message)s
PIPELINE_LOG_DATE_FORMAT=%H:%M:%S

# Write a copy of the log to this file as well as stderr. Leave empty to disable.
PIPELINE_LOG_FILE=

# ---------------------------------------------------------------------------
# Stage 1 — recall
# ---------------------------------------------------------------------------
# The dense retriever. This model is asymmetric: queries take the prefix below,
# documents never do.
DENSE_MODEL_NAME=mixedbread-ai/mxbai-embed-large-v1

# Matryoshka width used by the pipeline. 1024 = full model (the shipped setting).
# Truncating costs NDCG here: at 256 the dense channel scores below refined BM25.
DENSE_TRUNCATE_DIM=1024

DENSE_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# Okapi BM25 constants. k1 = term-frequency saturation, b = length normalisation.
BM25_K1=1.5
BM25_B=0.75

# How many times a title-like field is repeated relative to body text.
BM25_TITLE_WEIGHT=3

# Reciprocal Rank Fusion constant: score = 1/(K + rank). 60 is the usual default
# and the one the reported numbers were produced with.
RRF_K=60

# Candidate pool handed from Stage 1 to Stage 2.
CANDIDATE_POOL=50

# ---------------------------------------------------------------------------
# Stage 2 — features and evaluation
# ---------------------------------------------------------------------------
# A pair counts as relevant for P/R/MRR when its grade is at least this. NDCG
# uses the graded score directly and is unaffected.
RELEVANCE_THRESHOLD=40

# Stemming: a suffix is only stripped if what remains is at least this long.
STEM_MIN_LENGTH=4

# Model used to embed skill names for the `skill_soft` feature (runs on CPU).
SKILL_MODEL_NAME=mixedbread-ai/mxbai-embed-large-v1

# ---------------------------------------------------------------------------
# Paths (relative to pipeline/)
# ---------------------------------------------------------------------------
# Default corpus. run_all.sh and the module CLIs both accept --data-dir, which
# overrides this.
PIPELINE_DATA_DIR=data/data_set_v5_tax

# ---------------------------------------------------------------------------
# Reproduction
# ---------------------------------------------------------------------------
# GroupKFold split count and seed used by the rerankers.
CV_FOLDS=5
CV_SEED=7
